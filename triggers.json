          "script": {
            "value": "/**\n * @param {unknown[]} inputs\n * @returns {boolean} to break out current process\n * @returns {{type: EntryType; value: unknown}[]}\n *\n * @example\n * const x = inputs[0];\n * const y = inputs[1];\n * return [{type: \"number\", value: x + y}];\n */\nconst msg = inputs[0];\n\nreturn [\n  { type: \"boolean\", value: \n    msg?.item?.type === 'spell'\n    && !msg?.isRoll\n    && !msg?.flags?.pf2e?.appliedDamage\n    && msg?.token\n  },\n];"
