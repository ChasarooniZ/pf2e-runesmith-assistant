<div class="runesmith-target-dialog">
  <div class="form-section" id="type-section">
    <h4>{{localize 'pf2e-runesmith-assistant.dialog.target-menu.sections.type'}}</h4>
    <div class="option-row">
      <button class="option-button {{#if (eq type 'object')}}active{{/if}}" data-type="object">
        <i class="fa-solid fa-sack" inert></i>
        <span>{{localize 'pf2e-runesmith-assistant.dialog.target-menu.buttons.object'}}</span>
      </button>
      <button class="option-button {{#if (eq type 'person')}}active{{/if}}" data-type="person">
        <i class="fa-solid fa-person" inert></i>
        <span>{{localize 'pf2e-runesmith-assistant.dialog.target-menu.buttons.person'}}</span>
      </button>
    </div>
  </div>

  {{#if (eq type 'object')}}
  <div class="form-section" id="object-section">
    <h4>{{localize 'pf2e-runesmith-assistant.dialog.target-menu.sections.object-name'}}</h4>
    <input type="text" id="objectName" placeholder="Enter object name" value="{{objectName}}">
  </div>
  {{/if}}

  {{#if (eq type 'person')}}
  <div class="form-section" id="token-section">
    <h4>{{localize 'pf2e-runesmith-assistant.dialog.target-menu.sections.select-tokens'}}</h4>
    <div class="token-selector" id="token-list">
      {{#each tokens}}
      <div class="token-card {{#if this.selected}}selected{{/if}}" 
           data-token-id="{{this.id}}">
        <img src="{{this.img}}">
        <div>{{this.name}}</div>
      </div>
      {{/each}}
    </div>
    {{#if (gt selectedCount 1)}}
    <div class="selected-count">{{localize 'pf2e-runesmith-assistant.dialog.target-menu.misc.x-tokens-selected' tokenCount=selectedCount}}</div>
    {{/if}}
  </div>
  {{/if}}

  {{#if (gt selectedCount 0)}}
  <div class="form-section" id="location-section">
    <h4>{{localize 'pf2e-runesmith-assistant.dialog.target-menu.sections.person-rune-location'}}</h4>
    <div class="option-row">
      <button class="option-button {{#if (eq location 'actor')}}active{{/if}}" data-location="actor">
      <i class="fa-solid fa-circle-user" inert></i>
        <span>{{localize 'pf2e-runesmith-assistant.dialog.target-menu.buttons.person'}}</span>
      </button>
      <button class="option-button {{#if (eq location 'item')}}active{{/if}}" data-location="item">
      <i class="fa-solid fa-backpack" inert></i>
        <span>{{localize 'pf2e-runesmith-assistant.dialog.target-menu.buttons.worn-item'}}</span>
      </button>
    </div>
  </div>
  {{/if}}

  {{#if (eq location 'item')}}
  <div class="form-section" id="item-name-section">
    <h4>{{localize 'pf2e-runesmith-assistant.dialog.target-menu.buttons.item-name'}}</h4>
    <input type="text" id="itemNameInput" placeholder="{{localize 'pf2e-runesmith-assistant.dialog.target-menu.placeholder.item-name'}}" value="{{itemName}}">
  </div>
  {{/if}}
</div>